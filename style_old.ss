/* Home Contents */

#HomeContents{
    background: #fff url(images/HospitalBackground.jpg) center bottom/cover no-repeat content-box fixed;
    position: absolute;
    padding-top: 1rem;    
    text-align: center;
    font-size: 18px;
    padding: 0 1.875rem;
    top: 50%;
    left: 50%;  
    transform: translate(-50%, -50%);
    z-index: -1;
    width: 100%;
}
    
#HomeContents p{
    margin-left: 20rem;
    margin-right: 20rem;
}
    
/* Details form */

.details-form {
max-width: 600px;
margin: 30px auto;
background: #1D306D ;
padding: 30px;
border: 2px solid #813772;
border-radius: 10px;
color: #f4f4f4 ;
text-align: center;
}

.details-form input{
width: 175px;
height: 20px;
}

.details-form #Register {
background: rgba(16, 196, 10, 0.8);
border: none;
color: #f4f4f4 ;
cursor: pointer;
text-align: center;
}

.details-form  #Register:hover {
background: rgba(16, 196, 1);
}

.details-form img{
display: block;
width: 80px; 
height:80px;
float: left;
position: fixed;
}

.details-form #login {
background: rgba(16, 196, 10, 0.8);
border: none;
color: #f4f4f4 ;
cursor: pointer;
text-align: center;
}

.details-form  #login:hover {
background: rgba(16, 196, 1);
}

.details-form a {
color: #E1D9D1;
font-size: 10px;

}

.details-form .register{
font-size: 14px;
}

.details-form #sex {
width: 145px;
height: 20px;

}

.details-form a:hover {
color: rgba(16, 196, 0.8);
}

/*Profile Updtate Details*/

#update-form {
